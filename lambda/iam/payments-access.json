{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadPaymentsAndCloudFrontSecrets",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": [
        "arn:aws:ssm:eu-west-3:211125757125:parameter/futurion/payments/oauth-client",
        "arn:aws:ssm:eu-west-3:211125757125:parameter/futurion/payments/entitlement-secret",
        "arn:aws:ssm:eu-west-3:211125757125:parameter/futurion/trustprompt/cf-private-key"
      ]
    },
    {
      "Sid": "ReadWriteOAuthTokens",
      "Effect": "Allow",
      "Action": ["ssm:GetParameter", "ssm:PutParameter"],
      "Resource": [
        "arn:aws:ssm:eu-west-3:211125757125:parameter/futurion/payments/oauth-refresh-token",
        "arn:aws:ssm:eu-west-3:211125757125:parameter/futurion/payments/oauth-access-token"
      ]
    },
    {
      "Sid": "DecryptAndEncryptSecrets",
      "Effect": "Allow",
      "Action": ["kms:Decrypt", "kms:Encrypt"],
      "Resource": "arn:aws:kms:eu-west-3:211125757125:alias/aws/ssm"
    },
    {
      "Sid": "ListOnlyPaidArtifactPrefixesPLACEHOLDERUpdateBeforeDeploy",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::es-futurion-trustprompt",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["PENDING-OWNER-SUPPLIED-PREFIX-tmp-payments-md-section-12/*"]
        }
      }
    }
  ]
}
