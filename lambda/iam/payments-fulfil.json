{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadPaymentsSecrets",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": [
        "arn:aws:ssm:eu-west-3:211125757125:parameter/futurion/payments/qonto-auth",
        "arn:aws:ssm:eu-west-3:211125757125:parameter/futurion/payments/entitlement-secret"
      ]
    },
    {
      "Sid": "DecryptPaymentsSecrets",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "arn:aws:kms:eu-west-3:211125757125:alias/aws/ssm"
    },
    {
      "Sid": "SendFulfilmentAndInternalEmails",
      "Effect": "Allow",
      "Action": ["ses:SendEmail", "ses:SendRawEmail"],
      "Resource": [
        "arn:aws:ses:eu-west-3:211125757125:identity/solutions@futurion.es",
        "arn:aws:ses:eu-west-3:211125757125:identity/futurion.es",
        "arn:aws:ses:eu-west-3:211125757125:configuration-set/my-first-configuration-set"
      ]
    }
  ]
}
