{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadSigningSecrets",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": [
        "arn:aws:ssm:eu-west-3:211125757125:parameter/futurion/trustprompt/cf-private-key",
        "arn:aws:ssm:eu-west-3:211125757125:parameter/futurion/trustprompt/download-token-secret"
      ]
    },
    {
      "Sid": "DecryptSigningSecrets",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "arn:aws:kms:eu-west-3:211125757125:alias/aws/ssm"
    }
  ]
}
