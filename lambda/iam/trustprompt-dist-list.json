{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOnlyDistPrefixes",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::es-futurion-trustprompt",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["models/openmed/*/dist/", "models/openmed/*/dist/*"]
        }
      }
    }
  ]
}
