---
import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Contacto',
  description: 'Ponte en contacto con Futurion Solutions. ¿Tienes alguna pregunta sobre la automatización con IA diseñada para cumplir la normativa en tu consulta sanitaria? Respondemos en un plazo de 24 horas laborables.',
  openGraph: {
    images: [{ url: '~/assets/images/team-collaboration.jpg' }],
  },
};
---

<Layout metadata={metadata}>
  <JsonLd schema={{
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "@id": "https://solutions.futurion.es/es/contacto/",
    "url": "https://solutions.futurion.es/es/contacto/",
    "name": "Contacto con Futurion Solutions",
    "description": "Ponte en contacto con Futurion Solutions para implantar automatización con IA conforme a la normativa en tu consulta sanitaria.",
    "inLanguage": "es",
    "publisher": { "@id": "https://solutions.futurion.es/#organization" }
  }} />

  <!-- HeroText -->

  <HeroText
    tagline="Contacta con nosotros"
    title="Hablemos de tu consulta"
    subtitle="¿Tienes preguntas sobre la automatización con IA centrada en el cumplimiento normativo? ¿Quieres saber cómo podemos ayudar a tu consulta sanitaria a ahorrar tiempo sin dejar de cumplir la normativa? Nos encantará saber de ti."
  />

  <ContactUs
    id="form"
    title="Envíanos un mensaje"
    subtitle="Tanto si tienes alguna pregunta sobre nuestros servicios como si quieres hablar de tus necesidades o ya estás listo para empezar tu Hoja de Ruta de Automatización gratuita, escríbenos."
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Tu nombre',
      },
      {
        type: 'email',
        name: 'email',
        label: 'Correo electrónico',
      },
      {
        type: 'text',
        name: 'practice_name',
        label: 'Nombre de la consulta (opcional)',
      },
      {
        type: 'text',
        name: 'inquiry_type',
        label: 'Tipo de consulta (p. ej., Hoja de Ruta de Automatización, servicios o pregunta general)',
      },
    ]}
    textarea={{
      label: 'Tu mensaje',
      name: 'message',
      placeholder: 'Cuéntanos algo sobre tu consulta y cómo podemos ayudarte...',
    }}
    disclaimer={{
      label:
        'Al enviar este formulario, aceptas que recopilemos tus datos para responder a tu consulta. Trataremos tus datos de acuerdo con nuestra Política de Privacidad y los requisitos del RGPD.',
    }}
    button="Enviar mensaje"
    description="Respondemos en un plazo de 24 horas laborables."
  />

  <!-- Información de Contacto -->

  <Features2
    title="Otras formas de contactarnos"
    subtitle="Síguenos para conocer información sobre cumplimiento normativo y novedades sobre nuestros productos."
    items={[
      {
        title: 'Facebook',
        description: 'Síguenos en Facebook para estar al día de nuestras novedades y anuncios.',
        icon: 'tabler:brand-facebook',
        callToAction: {
          text: 'Visita Facebook',
          href: 'https://www.facebook.com/solutions.futurion.es/',
          target: '_blank',
          variant: 'link',
        },
      },
      {
        title: 'LinkedIn',
        description: 'Conecta con nosotros en LinkedIn para conocer información sobre cumplimiento normativo y nuestras novedades.',
        icon: 'tabler:brand-linkedin',
        callToAction: {
          text: 'Visita LinkedIn',
          href: 'https://www.linkedin.com/company/111621147/',
          target: '_blank',
          variant: 'link',
        },
      },
      {
        title: 'Instagram',
        description: 'Síguenos en Instagram para ver lo que ocurre entre bastidores.',
        icon: 'tabler:brand-instagram',
        callToAction: {
          text: 'Visita Instagram',
          href: 'https://www.instagram.com/solutions.futurion.es/',
          target: '_blank',
          variant: 'link',
        },
      },
    ]}
  />
</Layout>
