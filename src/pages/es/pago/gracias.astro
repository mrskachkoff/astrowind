---
import Layout from '~/layouts/PageLayout.astro';
import Button from '~/components/ui/Button.astro';

// Stripe's Checkout Session `success_url` lands here after a card payment.
// Transactional/no-op page — no network calls, no session lookup (fulfilment
// runs server-side off the Stripe webhook, independent of whether the
// customer's browser ever reaches this page). Kept out of src/i18n/slugs.ts
// and marked noindex, matching /es/pago/ and /es/pago/acceso/
// (tmp/payments.md §7.1).
const metadata = {
  title: 'Pago recibido',
  description: 'Hemos recibido tu pago — tu enlace de acceso está de camino por correo.',
  robots: {
    index: false,
    follow: true,
  },
};
---

<Layout metadata={metadata}>
  <section class="flex items-center h-full p-16">
    <div class="container flex flex-col items-center justify-center px-5 mx-auto my-8">
      <div class="max-w-md text-center">
        <h1 class="text-3xl font-bold md:text-4xl">Pago recibido</h1>
        <p class="mt-4 mb-8 text-lg text-muted dark:text-slate-400">
          Gracias — tu pago se ha procesado correctamente. Revisa tu correo: tu enlace de acceso (o la confirmación del
          depósito) está de camino, normalmente en pocos minutos.
        </p>
        <Button variant="primary" href="/es/">Volver al inicio</Button>
      </div>
    </div>
  </section>
</Layout>
