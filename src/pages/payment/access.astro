---
import Layout from '~/layouts/PageLayout.astro';
import PaymentAccess from '~/components/widgets/PaymentAccess.astro';

// Transactional page reached only via the emailed entitlement link (its
// token lives in the URL fragment, read client-side only) — kept out of
// src/i18n/slugs.ts and marked noindex on purpose (tmp/payments.md §7.1).
const metadata = {
  title: 'Access Your Purchase',
  description: 'Access the download for your TrustPrompt or TrustCore purchase.',
  robots: {
    index: false,
    follow: true,
  },
};
---

<Layout metadata={metadata}>
  <PaymentAccess id="access" title="Access Your Purchase" />
</Layout>
