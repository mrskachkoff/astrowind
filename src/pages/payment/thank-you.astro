---
import Layout from '~/layouts/PageLayout.astro';
import Button from '~/components/ui/Button.astro';

// Stripe's Checkout Session `success_url` lands here after a card payment.
// Transactional/no-op page — no network calls, no session lookup (fulfilment
// runs server-side off the Stripe webhook, independent of whether the
// customer's browser ever reaches this page). Kept out of src/i18n/slugs.ts
// and marked noindex, matching /checkout/ and /payment/access/
// (tmp/payments.md §7.1).
const metadata = {
  title: 'Payment received',
  description: 'Your payment was received — your access link is on its way by email.',
  robots: {
    index: false,
    follow: true,
  },
};
---

<Layout metadata={metadata}>
  <section class="flex items-center h-full p-16">
    <div class="container flex flex-col items-center justify-center px-5 mx-auto my-8">
      <div class="max-w-md text-center">
        <h1 class="text-3xl font-bold md:text-4xl">Payment received</h1>
        <p class="mt-4 mb-8 text-lg text-muted dark:text-slate-400">
          Thank you — your payment went through. Check your inbox: your access link (or deposit confirmation) is on its
          way by email, usually within a few minutes.
        </p>
        <Button variant="primary" href="/">Back to homepage</Button>
      </div>
    </div>
  </section>
</Layout>
