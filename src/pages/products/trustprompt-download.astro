---
import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import DownloadGate from '~/components/widgets/DownloadGate.astro';

const metadata = {
  title: 'Download TrustPrompt — Free Individual Build',
  description:
    'Get the free TrustPrompt individual build. Choose a language, confirm your details, and we generate a short-lived download link for that release.',
};
---

<Layout metadata={metadata}>
  <JsonLd
    schema={{
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      '@id': 'https://solutions.futurion.es/products/trustprompt-download/',
      url: 'https://solutions.futurion.es/products/trustprompt-download/',
      name: 'Download TrustPrompt — Free Individual Build',
      description: 'Get the free TrustPrompt individual build for one user, fully local.',
      inLanguage: 'en',
      isPartOf: { '@id': 'https://solutions.futurion.es/#organization' },
    }}
  />

  <!-- HeroText -->

  <HeroText
    tagline="Free Download"
    title="Get TrustPrompt — Individual"
    subtitle="One user, fully local. Pick your language below and we'll generate a download link for that build."
  />

  <DownloadGate
    id="download"
    title="Download TrustPrompt"
    subtitle="We'll email you the details and generate a short-lived link for the build you request."
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Your Name',
      },
      {
        type: 'email',
        name: 'email',
        label: 'Email Address',
      },
      {
        type: 'text',
        name: 'company',
        label: 'Company (optional)',
      },
      {
        type: 'text',
        name: 'role',
        label: 'Role (optional)',
      },
    ]}
    disclaimer={{
      label:
        'By submitting this form, you agree to the collection of your information for the purpose of providing this download. Your data is processed in accordance with our Privacy Policy and GDPR requirements.',
    }}
    button="Download Free"
    description="The link expires shortly after it's generated — if it lapses before your download finishes, use the button on the confirmation screen to get a new one."
  />
</Layout>
